# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.bg-shell/
# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# Python (apps/ml) — a virtualenv is ~12k files. Left untracked it still gets
# crawled by anything walking the repo (Metro watched it on every RN start), so it
# is excluded here AND in apps/pravaah-rn/metro.config.js.
.venv/
venv/
__pycache__/
*.py[cod]
# Trained model artefacts: build output, reproducible from `python -m app.train`
# with a fixed seed. A committed .joblib is an unreviewable binary that would
# silently outrank the code that produced it.
*.joblib


# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem

# graphify
graphify-out/cache/*
graphify-out/.graphify_*
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/*.backup.json
.env*
