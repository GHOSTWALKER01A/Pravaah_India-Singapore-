    },
    "./kyc": {
      "types": "./dist/kyc/index.d.cts",
      "default": "./dist/kyc/index.cjs"
    },
    "./consent": {
      "types": "./dist/consent/index.d.cts",
      "default": "./dist/consent/index.cjs"
    },
    "./scoring": {
      "types": "./dist/scoring/index.d.cts",
