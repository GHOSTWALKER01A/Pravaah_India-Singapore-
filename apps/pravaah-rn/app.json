{
  "expo": {
    "name": "MyPravaah",
    "slug": "parvaah-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parvaahrn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pravaah.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E3B2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.pravaah.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E3B2E",
          "dark": {
            "backgroundColor": "#06120E"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0E3B2E",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Pravaah uses the camera to capture your selfie for the liveness check, to photograph your ID document for verification, and to scan UPI QR codes when you pay.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pravaah opens your photos only when you choose one — to read a UPI QR code out of a picture you already have, or to attach a document to an insurance claim.",
          "cameraPermission": "Pravaah uses the camera to scan UPI QR codes when you pay.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pravaah uses Face ID to unlock your account and to confirm changes to your payment PIN."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Pravaah uses Face ID to unlock the session it keeps on this phone."
        }
      ],
      "./plugins/with-release-network-security",
      "./plugins/with-android-ndk-version"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46f026c0-b26b-456c-93d0-d8ebfb5fe004"
      }
    }
  }
}
