enum DeviceStatus {
  /**
   * Bind requested, challenge not yet passed. M6 creates the row in this state so
   * the step-up challenge has something to attach to, and NOTHING treats it as a
   * bound device — `BINDING` is not `ACTIVE`, so a caller that skipped the
   * challenge is indistinguishable from a caller with no device at all.
